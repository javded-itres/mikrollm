# cp .env.example .env
# .env читает docker compose. Пароль и токен не коммитьте.

ADMIN_PASSWORD=change-me

# Необязательно. У Qwen3.6 веса открытые; токен снимает лимит Hugging Face.
# HF_TOKEN=hf_...

# Образ. Blackwell: vllm/vllm-openai:cu130-nightly
# VLLM_IMAGE=vllm/vllm-openai:latest

# Чекпоинт. Короткое имя для клиентов остаётся qwen3.6.
# VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# Родной контекст 262144. 32768 — старт на одной карте 24–48 ГБ.
# VLLM_MAX_MODEL_LEN=32768
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_MAX_NUM_SEQS=8
# VLLM_TENSOR_PARALLEL_SIZE=1
