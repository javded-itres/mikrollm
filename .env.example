# cp .env.example .env
# .env читает docker compose. Пароль и токен не коммитьте.

ADMIN_PASSWORD=change-me

# Образ шлюза. Тег совпадает с релизом на Docker Hub.
# MIKROLLM_IMAGE=javded/mikrollm:v0.0.13

# Необязательно. У Qwen3.6 веса открытые; токен снимает лимит Hugging Face.
# HF_TOKEN=hf_...

# Tesla V100S 32GB (sm_70). latest без ядер sm_70 на этой карте не стартует.
# VLLM_IMAGE=vllm/vllm-openai:v0.18.0

# GPTQ Int4 той же Qwen3.6-27B. FP8 и BF16 на одну V100S 32GB не встают.
# Имя для клиентов остаётся qwen3.6.
# VLLM_MODEL=btbtyler09/Qwen3.6-27B-GPTQ-4bit

# 16384 помещается в 32 ГБ рядом с Int4-весами. 262144 — нет.
# VLLM_MAX_MODEL_LEN=16384
# VLLM_GPU_MEMORY_UTILIZATION=0.90
# VLLM_MAX_NUM_SEQS=4
# VLLM_TENSOR_PARALLEL_SIZE=1
