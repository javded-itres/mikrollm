# Multi-arch image for Docker Hub (javded/mikrollm).
# The root Dockerfile stays a scratch copy of a prebuilt dist/mikrollm
# so RouterOS images do not compile inside Docker.
FROM --platform=$BUILDPLATFORM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/mikrollm ./cmd/mikrollm

FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/mikrollm /mikrollm
EXPOSE 4000
ENTRYPOINT ["/mikrollm"]
CMD ["-data", "/data", "-listen", ":4000"]
